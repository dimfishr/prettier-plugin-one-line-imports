{
  "name": "prettier-plugin-one-line-imports",
  "version": "1.0.3",
  "description": "A Prettier plugin to always force TypeScript imports on one line (and get rid of these ugly multi-line statements spanning half your screen).",
  "author": "Martin Zima",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimfishr/prettier-plugin-one-line-imports"
  },
  "type": "module",
  "main": "dist/index.mjs",
	"module": "dist/index.mjs",
  "types": "src/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c",
    "test": "vitest",
    "clean": "del dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "prettier",
    "prettier-plugin",
    "typescript",
    "plugin",
    "formatting",
    "code style",
    "imports"
  ],
  "devDependencies": {
    "@types/node": "^24.10.4",
    "@types/prettier": "^2.7.3",
    "del-cli": "^6.0.0",
    "prettier": "^3.7.4",
    "rolldown": "1.0.0-beta.58",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  }
}
